# Copy this to .env and adjust for your environment
# docker-compose.yml already injects these for containers
# This file is for running the backend locally without Docker

DATABASE_URL=postgresql://jobflow:jobflow_secret@localhost:5432/jobflow_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
SECRET_KEY=change_me_in_production
CACHE_TTL=300
